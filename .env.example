# Copy this file to .env and set your own values.
TELEGRAM_BOT_TOKEN=your_bot_token

# Optional: configure both destinations to send every contact message to both.
# Use a channel username such as @your_channel or its numeric ID.
TELEGRAM_CHANNEL_ID=@your_channel

# Telegram group IDs are usually negative numbers beginning with -100.
TELEGRAM_GROUP_ID=-1001234567890

# Optional additional private chat destination.
# TELEGRAM_CHAT_ID=
